{
  "name": "web-debug-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-native local web debugging through one bounded MCP surface.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/adapters/vite-plugin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "harness:check": "node scripts/harness-check.mjs",
    "smoke:live": "npm run build && node scripts/live-smoke.mjs",
    "smoke:next": "npm run build && node scripts/live-next-smoke.mjs",
    "smoke:react-vite": "npm run build && node scripts/live-react-vite-smoke.mjs",
    "serve:next": "node scripts/serve-next.mjs",
    "serve:react-vite": "node scripts/serve-react-vite.mjs",
    "serve:fixture": "node scripts/serve-fixture.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright-core": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.1.1",
    "@types/node": "24.3.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
