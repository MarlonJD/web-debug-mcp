{
  "name": "web-debug-mcp",
  "version": "0.3.3",
  "description": "Local evidence-first web debugging MCP server for Codex, Claude Code, and other MCP clients.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "bin": {
    "web-debug-mcp": "bin/web-debug-mcp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/adapters/vite-plugin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarlonJD/web-debug-mcp.git"
  },
  "homepage": "https://github.com/MarlonJD/web-debug-mcp#readme",
  "bugs": {
    "url": "https://github.com/MarlonJD/web-debug-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-debugging",
    "developer-tools",
    "codex",
    "claude-code",
    "chromium",
    "safari",
    "react",
    "vite",
    "nextjs",
    "cdp"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/index.ts",
    "harness:check": "node scripts/harness-check.mjs",
    "smoke:live": "npm run build && node scripts/live-smoke.mjs",
    "smoke:next": "npm run build && node scripts/live-next-smoke.mjs",
    "smoke:react-vite": "npm run build && node scripts/live-react-vite-smoke.mjs",
    "smoke:safari": "npm run build && node scripts/live-safari-smoke.mjs",
    "smoke:local-fidelity": "npm run build && node scripts/live-local-fidelity-smoke.mjs",
    "demo:compare": "npm run build --silent && node scripts/demo-compare.mjs",
    "serve:next": "node scripts/serve-next.mjs",
    "serve:react-vite": "node scripts/serve-react-vite.mjs",
    "serve:fixture": "node scripts/serve-fixture.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright-core": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.1.1",
    "@types/node": "24.3.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
